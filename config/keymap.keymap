#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none      &none  &none     &none     &none  &none                                     &none      &none  &none      &none            &none      &none
&kp TAB    &kp Q  &kp W     &kp E     &kp R  &kp T                                     &kp Y      &kp U  &kp I      &kp O            &kp P      &kp MINUS
&kp LCTRL  &kp A  &kp S     &kp D     &kp F  &kp G        &none         &none          &kp H      &kp J  &kp K      &kp L            &kp SEMI   &kp RETURN
&kp LSHFT  &kp Z  &kp X     &kp C     &kp V  &kp B        &none         &none          &kp N      &kp M  &kp COMMA  &kp DOT          &kp SLASH  &mo 3
&none      &none  &kp LGUI  &kp LALT  &mo 2  &lt 1 SPACE  &lt 3 ESCAPE  &kp BACKSPACE  &kp SPACE  &none  &none      &kp PRINTSCREEN  &mo 1      &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                  &trans        &trans           &trans       &trans        &trans  &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                  &kp NUMBER_6  &kp N7           &kp N8       &kp NUMBER_9  &kp N0  &trans
&trans  &trans        &trans        &trans        &trans        &trans  &trans  &trans  &mkp MB5      &mkp LCLK        &mkp RCLK    &mkp MCLK     &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans  &trans  &trans  &mkp MB4      &kp LC(LS(TAB))  &kp LC(TAB)  &trans        &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans        &trans           &trans       &trans        &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans     &trans       &trans             &trans      &trans     &trans                     &trans         &trans                &trans                 &trans     &trans       &trans
&kp TILDE  &kp SQT      &kp DOUBLE_QUOTES  &kp EXCL    &trans     &kp PLUS                   &kp BACKSLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EQUAL  &kp PERCENT  &trans
&trans     &kp AT_SIGN  &kp SEMICOLON      &kp DOLLAR  &trans     &trans     &trans  &trans  &kp HASH       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE   &trans       &trans
&trans     &trans       &kp ASTERISK       &kp COLON   &kp CARET  &kp GRAVE  &trans  &trans  &kp AMPS       &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans     &trans       &trans
&trans     &trans       &trans             &trans      &trans     &trans     &trans  &trans  &trans         &trans                &trans                 &trans     &trans       &trans
            >;
        };

        layer_3 {
            bindings = <
&trans      &trans         &trans          &trans         &trans         &trans                                     &trans    &trans         &trans        &trans     &trans   &trans
&trans      &kp F1         &kp F2          &kp F3         &kp F4         &kp F5                                     &kp F6    &kp F7         &kp F8        &kp F9     &kp F10  &kp DELETE
&trans      &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &trans        &trans        &kp LEFT  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp F11  &trans
&trans      &bt BT_DISC 0  &bt BT_DISC 1   &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &out OUT_BLE  &out OUT_USB  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &kp F12  &trans
&sys_reset  &trans         &bt BT_CLR_ALL  &bt BT_CLR     &trans         &trans         &trans        &trans        &trans    &trans         &trans        &trans     &trans   &sys_reset
            >;
        };
    };
};
